{
  "manifest_version": 3,
  "name": "Sheets to Voice Autodialer",
  "version": "1.0.0",
  "description": "Send phone numbers from Google Sheets to Google Voice dial pad.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting", "tabs", "activeTab", "alarms"],
  "host_permissions": [
    "https://voice.google.com/*",
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/spreadsheets/*",
        "https://docs.google.com/spreadsheets/u/*"
      ],
      "js": ["content-sheets.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://voice.google.com/*",
        "https://voice.google.com/u/*"
      ],
      "js": ["content-voice.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Sheets to Voice Autodialer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
